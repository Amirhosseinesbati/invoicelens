# Public build-time display defaults. Never put credentials here.
VITE_PRODUCT_NAME=InvoiceLens
# Blank inherits the authenticated workspace name.
VITE_WORKSPACE_LABEL=
# indigo | teal | copper
VITE_ACCENT=indigo
# Dev proxy only. Requests in the browser stay on the same origin.
VITE_API_PROXY_TARGET=http://127.0.0.1:8312
