# Copy to .env for a PostgreSQL-backed installation. Generate unique secrets.
INVOICELENS_MODE=CONNECTED
POSTGRES_DB=invoicelens
POSTGRES_USER=invoicelens
# Use a long URL-safe value; Compose includes it in a SQLAlchemy URL.
POSTGRES_PASSWORD=
# Unique, at least 32 characters in CONNECTED mode.
INVOICELENS_SECRET_KEY=
INVOICELENS_COOKIE_SECURE=false
INVOICELENS_ALLOWED_ORIGIN=http://127.0.0.1:5789
INVOICELENS_OPENAI_MODEL=
INVOICELENS_OPENAI_API_KEY=
INVOICELENS_OPENAI_MAX_OUTPUT_TOKENS=2048
INVOICELENS_OCR_LANGUAGE=eng
INVOICELENS_AUTO_WORKER=true

# Direct API execution may override these Compose-provided values.
# INVOICELENS_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/invoicelens
# INVOICELENS_STORAGE_ROOT=./data/storage
# INVOICELENS_CHECKPOINT_PATH=./data/checkpoints.sqlite3
